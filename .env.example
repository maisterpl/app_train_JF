# Dokumentacja zmiennych procesu; plik nie jest automatycznie wczytywany.
# PowerShell: $env:DJANGO_DEBUG = "1"
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-your-own-stable-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dla zaufanego dostępu HTTPS; lista po przecinku, z protokołem:
DJANGO_CSRF_TRUSTED_ORIGINS=https://trening.example.com

# Lokalnie DEBUG=1 wysyła potwierdzenia tylko do terminala.
# Produkcja: DEBUG=0, trwały losowy sekret, HTTPS, prawdziwa poczta.
# DJANGO_DB_PATH=/var/data/db.sqlite3
# DJANGO_TRUST_PROXY=true
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Google Cloud: aplikacja OAuth typu Web; wpisz wartości bezpiecznie na serwerze.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
